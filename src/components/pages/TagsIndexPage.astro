---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { t, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const posts = await getCollection('blog');
const tagCount = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    tagCount.set(tag, (tagCount.get(tag) ?? 0) + 1);
  }
}
const tags = [...tagCount.entries()].sort(
  (a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'zh-CN'),
);
---

<Layout title={t(locale, 'meta.tags')} description={t(locale, 'meta.tags.desc')} locale={locale}>
  <main class="container page">
    <a class="back" href={getRelativeLocaleUrl(locale, '')}>{t(locale, 'back.home')}</a>
    <header class="page-head">
      <h1>{t(locale, 'meta.tags')}</h1>
      <p>{t(locale, 'tags.count', { n: tags.length })}</p>
    </header>

    <ul class="tag-cloud">
      {
        tags.map(([tag, count]) => (
          <li>
            <a href={getRelativeLocaleUrl(locale, `tags/${encodeURIComponent(tag)}`)}>
              {tag}
              <span class="tag-count">{count}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</Layout>
