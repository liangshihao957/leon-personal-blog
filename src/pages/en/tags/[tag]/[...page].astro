---
import { getCollection } from 'astro:content';
import TagsListPage from '../../../../components/pages/TagsListPage.astro';

export async function getStaticPaths({ paginate }) {
  const allPosts = await getCollection('blog');
  const tagSet = new Set<string>();
  for (const post of allPosts) {
    for (const tag of post.data.tags) tagSet.add(tag);
  }
  return [...tagSet].flatMap((tag) => {
    const tagPosts = allPosts
      .filter((p) => p.data.tags.includes(tag))
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
    return paginate(tagPosts, { pageSize: 10, params: { tag } });
  });
}

const { page } = Astro.props;
const { tag } = Astro.params;
---

<TagsListPage locale="en" tag={tag} page={page} />
